# Copy to migration.env and fill in real values.
#   cp migration.env.example migration.env
# Do NOT commit migration.env (gitignored).
#
# Load order (first found wins unless MIGRATION_ENV is set):
#   1) $MIGRATION_ENV
#   2) <script-dir>/migration.env
#   3) ./scripts/migration.env
#   4) ./migration.env

# --- Connection ---
# Domain endpoint only, no trailing slash.
# Example:
#   OS_BASE_URL=https://search-YOUR-DOMAIN.REGION.es.amazonaws.com
OS_BASE_URL=https://search-YOUR-DOMAIN.REGION.es.amazonaws.com

# basic  = Fine-grained access control user/password (curl -u)
# none   = no Authorization header (IP policy / VPC only; rare)
# If the app uses IAM SigV4 at runtime, curl migration still needs an FGAC
# basic-auth user (or awscurl) unless the domain allows unauthenticated access.
OS_AUTH=basic
OS_USERNAME=admin
OS_PASSWORD=CHANGE_ME

# Set to true only if you must skip TLS verify (not recommended).
OS_INSECURE=false

# --- Index migration targets ---
# Use your real index names (examples below are placeholders only).
#   my_index_v1 / app_events_001 / orders_archive
SOURCE_INDEX=my_index_v1
# Dest physical name defaults to ${SOURCE_INDEX}_reidx if DEST_INDEX is omitted.
DEST_SUFFIX=_reidx
DEST_INDEX=my_index_v1_reidx
# After cutover, alias name should equal what producers write (usually = SOURCE_INDEX).
# Defaults to SOURCE_INDEX if omitted.
ALIAS_NAME=my_index_v1

# --- Reindex tuning ---
# Full reindex throttle (docs/sec). Empty / 0 / off = no throttle (faster for small indexes).
# Keep a limit for large live indexes to protect the cluster.
# CLI e.g. REQUESTS_PER_SECOND=off overrides this file.
REQUESTS_PER_SECOND=1000
# Scroll/batch size for reindex
REINDEX_SIZE=1000
# Parallel slices as URL query (?slices=): auto | off | number
# (Do NOT put slices in the reindex JSON body on some clusters — HTTP 400.)
# migrate auto-tune tiers (docs):
#   < SMALL (250k): RPS off + slices off
#   < MID   (500k): RPS off, keep slices (good for multi-shard)
#   >= MID:         RPS off; slices off if 1 primary shard
#                   MIGRATE_LARGE_KEEP_RPS=yes → keep REQUESTS_PER_SECOND below
REINDEX_SLICES=auto
# MIGRATE_AUTO_TUNE=yes
# MIGRATE_AUTO_TUNE_SMALL_DOCS=250000
# MIGRATE_AUTO_TUNE_MID_DOCS=500000
# MIGRATE_LARGE_KEEP_RPS=yes
# Live writers: allow small source>dest gap before lock (final-delta drains).
# COMPARE_MAX_DIFF=100
# Cutover: POST /_aliases {remove_index, add} (atomic). Snapshot strategy:
#   - Before write-block: wait until SOURCE not in _snapshot/_status
#   - Under lock: retry cutover, but abort+unblock if WRITE_BLOCK_MAX_SECONDS exceeded
# CUTOVER_SNAPSHOT_RETRIES=36
# CUTOVER_SNAPSHOT_SLEEP_SECONDS=10
# SNAPSHOT_PRECHECK=yes
# SNAPSHOT_WAIT_BEFORE_LOCK_SECONDS=300
# SNAPSHOT_POLL_SECONDS=15
# WRITE_BLOCK_MAX_SECONDS=120
# FINAL_DELTA_SYNC=yes
# MIGRATE_LARGE_REINDEX_SIZE=2500
# Prefer cutover outside automated snapshot windows when possible.

# Delta watermark: a sortable string/date field written by producers before index.
# Must match your document mapping. Example format: %Y/%m/%d %H:%M:%S
WATERMARK_FIELD=EventTimestamp
# Minutes to subtract from recorded T0 / each delta start for safety (refresh / clock skew)
DELTA_MARGIN_MINUTES=5
# final-delta only: minutes before last catchup delta start (keep small)
FINAL_DELTA_MARGIN_MINUTES=1

# Multi-round catch-up (./opensearch_index_migration.sh catchup):
# Stop when last delta took <= this many seconds (goal: short write-block window).
DELTA_TARGET_SECONDS=60
# Max delta rounds in one catchup run
DELTA_MAX_ROUNDS=10
# Also stop when created <= this (0 = empty catch-up is enough)
DELTA_STOP_CREATED=0

# Work dir for dumped mapping/settings and state (task id, T0, watermarks).
# Relative paths resolve from the caller's cwd.
WORK_DIR=.migration_work
